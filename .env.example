# Docker Compose configuration for model2vec-serve.
#
# Copy this file to .env (git-ignored) and adjust as needed; `docker compose
# up -d` picks it up automatically. Every variable is optional — the defaults
# below match docker-compose.yml. See docs/deployment/compose.md.

# --- Compose-level settings (consumed by docker-compose.yml itself) ---

# Container image to run. Pin a release (e.g. ghcr.io/freinold/model2vec-serve:v0.6.0)
# or point at a locally built image (docker build -t model2vec-serve:local .).
#MODEL2VEC_IMAGE=ghcr.io/freinold/model2vec-serve:latest

# Host port the service is reachable on. The container always listens on
# 8080; the host side is bound to 127.0.0.1 (loopback) by default — edit the
# ports mapping in docker-compose.yml to expose beyond localhost.
#MODEL2VEC_PORT=8080

# Host directory for downloaded models, mounted at /models. Model artifacts
# land in <dir>/.cache/huggingface/hub and survive restarts. Host paths only;
# a named Docker volume requires editing docker-compose.yml.
#MODEL2VEC_CACHE_DIR=./models

# --- Service settings (passed to the container verbatim) ---

# Comma-separated Hugging Face model ids (or local model directories) to serve.
#MODEL=minishlab/potion-multilingual-128M,minishlab/potion-code-16M-v2

# Model used when a request does not name one. Defaults to the first MODEL
# entry (the multilingual model in the default stack); must be one of MODEL.
#DEFAULT_MODEL=

# Uncomment to require `Authorization: Bearer <key>` on the embedding
# endpoints (/health, /ready, /metrics stay public). Leave unset to disable
# authentication entirely — an empty value is never injected.
#API_KEY=

# Model publisher or owner shown in OpenAI-compatible /v1/models responses.
#MODEL_OWNER=minishlab

# Path identifier alias for a model, as KEY=ALIAS (comma-separated pairs).
#MODEL_ALIAS=

# Maximum number of input strings accepted in a single request.
#MAX_BATCH_SIZE=256

# Maximum tokens per input string.
#MAX_INPUT_LENGTH=512

# Log level: trace, debug, info, warn, or error.
#LOG_LEVEL=info

# Per-request timeout in seconds.
#REQUEST_TIMEOUT_SECONDS=30
